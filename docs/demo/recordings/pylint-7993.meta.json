   "tests": "import pytest\nfrom pylint.checkers.base.name_checker.naming_style import NamingStyle\n\n@pytest.mark.parametrize(\"name_type, expected_attr\", [\n    (\"module\", \"MOD_NAME_RGX\"),\n    (\"const\", \"CONST_NAME_RGX\"),\n    (\"class\", \"CLASS_NAME_RGX\"),\n    (\"function\", \"DEFAULT_NAME_RGX\"),\n    (\"method\", \"DEFAULT_NAME_RGX\"),\n    (\"attr\", \"DEFAULT_NAME_RGX\"),\n    (\"argument\", \"DEFAULT_NAME_RGX\"),\n    (\"variable\", \"DEFAULT_NAME_RGX\"),\n    (\"class_attribute\", \"CLASS_ATTRIBUTE_RGX\"),\n    (\"class_const\", \"CONST_NAME_RGX\"),\n    (\"inlinevar\", \"COMP_VAR_RGX\"),\n])\ndef test_get_regex_returns_correct_attribute(name_type, expected_attr):\n    # Get the regex from the base class (which uses ANY patterns)\n    regex = NamingStyle.get_regex(name_type)\n    expected = getattr(NamingStyle, expected_attr)\n    assert regex is expected\n\n@pytest.mark.parametrize(\"name_type\", [\n    \"moduled\",   # > 'module'\n    \"methody\",   # > 'method'\n    \"variablez\", # > 'variable'\n])\ndef test_get_regex_boundary_raises_keyerror(name_type):\n    # These inputs should raise KeyError in the original implementation.\n    # If the == comparisons are changed to >=, they would incorrectly\n    # return a regex instead of raising.\n    with pytest.raises(KeyError):\n        NamingStyle.get_regex(name_type)\n\ndef test_get_regex_unknown_raises_keyerror():\n    with pytest.raises(KeyError):\n        NamingStyle.get_regex(\"invalid_type\")\n",
